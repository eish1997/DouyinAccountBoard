const $=id=>document.getElementById(id);
function renderBackup(){const b=data.backup||{};$('backupState').textContent=b.enabled?(b.last_backup?'自动备份：'+new Date(b.last_backup).toLocaleString('zh-CN',{hour12:false})+' · 每4小时 / 保留30天':'自动备份：等待首次成功'):'自动备份未启动';$('backupState').title=b.directory||'';$('backupError').hidden=!b.error;$('backupError').textContent=b.error||'';}
let data=null,page='board',selected=new Set(),requestSerial=0;
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const abnormal=a=>['短期封禁','封禁','发不了','停用'].includes(a.status);
const badge=a=>`<span class="badge ${a.status==='正常'?'good':abnormal(a)?'warn':''}">${esc(a.status)}</span>`;
function toast(message){$('toast').textContent=message;$('toast').classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('toast').classList.remove('show'),2300);}
async function api(path,body){if(body&&data)body=versionPayload(path,body,data,activeEditVersions());const response=await fetch(path,{method:body?'POST':'GET',headers:body?{'Content-Type':'application/json','X-CSRF-Token':currentUser?.csrf||data?.user?.csrf||''}:{},body:body?JSON.stringify(body):undefined});const result=await response.json();if(response.status===401){location.replace(location.search==='?office=three'?'/login.html?next='+encodeURIComponent('/?office=three'):'/login.html');throw Error('登录已失效，请重新登录');}if(!response.ok)throw Error(result.error||'保存失败');if(data)applyVersionDelta(result._record_versions,data);return result;}
async function load(){const serial=++requestSerial;try{const next=await api('/api/board'+($('date').value?'?date='+encodeURIComponent($('date').value):''));if(serial!==requestSerial)return;data=next;renderVerificationFilter();$('date').value=data.date;$('loadError').hidden=true;const computerValue=$('computer').value,statusValue=$('status').value;$('computer').innerHTML='<option value="">全部电脑</option>'+data.computers.map(c=>`<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');$('computer').value=computerValue;$('status').innerHTML='<option value="">全部账号状态</option>'+data.statuses.map(s=>`<option>${esc(s)}</option>`).join('');$('status').value=statusValue;const bulkValue=$('bulkStatus').value;$('bulkStatus').innerHTML=data.statuses.map(s=>`<option>${esc(s)}</option>`).join('');if(bulkValue)$('bulkStatus').value=bulkValue;render();if(typeof CustomEvent!=='undefined')document.dispatchEvent(new CustomEvent('board-ready'));}catch(e){$('loadError').textContent='加载失败：'+e.message;$('loadError').hidden=false;}}
function filtered(){return officeAccounts(pageAccounts()).filter(a=>phoneDeviceMatches(a)&&lifecyclePresetMatches(a)&&accountSearchMatches(a)&&verificationMatches(a)&&(!$('computer').value||a.computer_id===$('computer').value)&&(!$('status').value||a.status===$('status').value)&&(!$('accountType').value||a.account_type===$('accountType').value)&&(!$('ageFilter').value||(a.account_type==='大号'&&($('ageFilter').value==='missing'?!a.registered_on:a.registered_on&&($('ageFilter').value==='mature'?a.days_remaining===0:a.days_remaining>0))))&&(!$('lifecycleFilter').value||a.lifecycle===$('lifecycleFilter').value)&&(!$('published').value||(!!a.published===($('published').value==='yes'))));}
function render(){if(!data)return;document.body.classList.toggle('board-fit',page==='board');renderBackup();renderOffices();const cardsPage=page==='cards',phonesPage=page==='phones';$('cardsWorkspace').hidden=!cardsPage;$('phonesWorkspace').hidden=!phonesPage;$('accountWorkspace').hidden=cardsPage||phonesPage;$('collectionBar').hidden=cardsPage||phonesPage;document.querySelector('.header-actions').hidden=cardsPage||phonesPage;renderPhoneFilter();if(cardsPage||phonesPage){$('lifecycleSummary').hidden=true;phonesPage?renderPhones():renderCards();if(typeof renderBatchControls==='function')renderBatchControls();applyPermissions();return;}lifecycleSummary();const officeScope=officeAccounts();const accounts=filtered().filter(a=>page!=='board'||a.computer_id!=='unassigned'),visibleIds=new Set(accounts.map(a=>a.id));for(const id of selected)if(!visibleIds.has(id))selected.delete(id);const done=accounts.filter(a=>a.published).length;const layoutCells=page==='board'?filteredPublishingCells(accounts):[],layoutActive=page==='board'&&publishingEnabled();const computerFilter=!!$('computer').value;const hosts=data.computers.filter(c=>c.id!=='unassigned'&&(!computerFilter||c.id===$('computer').value)&&(layoutActive?layoutCells.some(cell=>cell.computer_id===c.id):accounts.some(a=>a.computer_id===c.id)));
 $('stats').innerHTML=[['负责电脑',hosts.length,'本次筛选中的主机','▣'],['账号总数',accounts.length,layoutActive?'已匹配到发布格子的账号':'已导入的账号资料','◎'],['当天已发',done,accounts.length?Math.round(done/accounts.length*100)+'% 完成':'暂无账号','✓'],['当天未发',accounts.length-done,'待人工勾选记录','◷']].map((s,i)=>`<div class="stat ${i===2?'highlight':''}"><span class="stat-symbol">${s[3]}</span><div class="stat-label">${s[0]}</div><strong>${s[1]}</strong><small>${s[2]}</small></div>`).join('');
 $('autoCollect').checked=!!data.collection.auto_enabled;$('resumeCollect').hidden=!data.collection.paused&&data.collection.worker_status!=='等待手动登录或验证';$('collectionInfo').textContent=(data.collection.worker_online?'采集器在线 · '+data.collection.worker_status+' · ':data.collection.worker_status+' · ')+(data.collection.paused?'采集已暂停：'+data.collection.pause_reason:`${data.collection.linked} / ${data.accounts.length} 个账号已填写抖音号或主页 · ${data.collection.waiting} 个任务等待或正在采集 · ${data.collection.done} 个成功 / ${data.collection.failed} 个失败（全库共用）`);$('scope').textContent=`${officeName()} · ${data.date===data.today?'今天':data.date} · ${hosts.length} 台电脑 / ${accounts.length} 个账号${layoutActive?' · 工作进度表布局 / '+layoutCells.filter(c=>c.label&&!c.account_id).length+' 个格子待匹配':''}`;
 const slots=layoutActive?Math.max(3,...data.publishing_layout.cells.filter(c=>hosts.some(h=>h.id===c.computer_id)).map(c=>c.slot)):Math.max(3,...data.accounts.map(a=>a.slot));$('matrixHead').innerHTML='<tr><th>电脑 / 主机</th>'+Array.from({length:slots},(_,i)=>`<th>${layoutActive?'发布设备':'账号位置'} ${i+1}</th>`).join('')+'</tr>';
 $('matrixBody').innerHTML=hosts.map(c=>{const own=accounts.filter(a=>a.computer_id===c.id);return `<tr><td class="host"><strong>${esc(c.name)}</strong><small>${esc(c.shadow_account)} · ${esc(c.ip)}</small><div class="host-progress">${own.filter(a=>a.published).length} / ${own.length} 已发</div></td>`+Array.from({length:slots},(_,i)=>{const a=own.find(a=>a.slot===i+1);if(!a){if(layoutActive){const cell=data.publishing_layout.cells.find(cell=>cell.computer_id===c.id&&cell.slot===i+1);if(cell?.label){if(publishingCellOffice(cell)!==activeOffice&&activeOffice!=='all')return '<td><div class="empty-slot">其他办公室账号</div></td>';if(!cell.account_id&&layoutCells.includes(cell))return `<td><button type="button" class="account-card unresolved-card unresolved-link" data-match-computer="${esc(cell.computer_id)}" data-match-slot="${cell.slot}" ${hasPermission('publishing_manage')?'':'disabled title="需要管理发布格子关联权限"'}><div class="account-name">${esc(cell.label)}</div><span class="badge warn">待匹配账号 · 点击关联</span><small>${esc(cell.source_cell)} · ${esc(cell.reason||'需核对账号身份')}</small></button></td>`;return '<td><div class="empty-slot">已被筛选隐藏</div></td>';}return '<td><div class="empty-slot">暂无发布安排</div></td>';}const occupied=data.accounts.some(a=>a.computer_id===c.id&&a.slot===i+1);return `<td><div class="empty-slot">${occupied?(officeScope.some(a=>a.computer_id===c.id&&a.slot===i+1)?'已被筛选隐藏':'其他办公室账号'):'＋ 暂无账号'}</div></td>`;}return `<td><div class="account-card ${a.published?'done':''}">${typeof batchPick==='function'?`<label class="board-batch-pick">${batchPick('daily',a.id)} 选择账号</label>`:''}<div class="card-top"><div class="account-name">${esc(a.publishing_label||a.name)}</div>${badge(a)}</div>${verificationMarkup(a,true)}<div class="card-bottom"><button class="edit-card" data-edit="${esc(a.id)}">账号资料 ↗</button>${layoutActive&&data.publishing_layout.cells.some(cell=>cell.computer_id===c.id&&cell.slot===i+1&&cell.manual_link)&&hasPermission('publishing_manage')?`<button class="text-button manual-link-button" data-match-computer="${esc(c.id)}" data-match-slot="${i+1}">调整关联</button>`:''}<small class="card-count" title="${esc((a.last_collected||'尚无成功采集')+' · '+(a.collection_state||'待采集')+' '+(a.collection_error||''))}">作品 ${a.work_count===null?"待采集":a.work_count}<br>${esc(a.collection_state||'待采集')}</small><button class="publish-toggle" data-publish="${esc(a.id)}" aria-pressed="${!!a.published}">${a.published?'✓ 已发':'○ 未发'}</button></div></div></td>`;}).join('')+'</tr>';}).join('')||`<tr><td colspan="${slots+1}" class="empty-result">没有符合条件的账号，试试重置筛选。</td></tr>`;
 $('accountsBody').innerHTML=accounts.map(a=>`<tr><td><input type="checkbox" data-select="${esc(a.id)}" ${selected.has(a.id)?'checked':''} aria-label="选择账号 ${esc(a.name)}"></td><td><strong>${esc(a.name)}</strong><small>${a.douyin_id?'抖音号 '+esc(a.douyin_id):'抖音号待补充'}</small></td><td>登记：${esc(data.computers.find(c=>c.id===a.computer_id)?.name)}<small>实际发布：${actualPublishingText(a)}</small><small>${a.slot===null?'尚未分配位置':'账号位置 '+a.slot}</small><small>登录手机：${esc(a.phone_device_name||'待确认')}</small></td><td class="lifecycle-cell">${lifecycleDetails(a)}</td><td>${badge(a)}<small>稳定：${esc(a.card_stability||'待确认')}</small><small>改密：${esc(a.password_state||'待确认')}</small></td><td>${verificationMarkup(a)}</td><td><button class="publish-toggle" data-publish="${esc(a.id)}" aria-pressed="${!!a.published}">${a.published?'✓ 已发':'○ 未发'}</button></td><td>${a.work_count===null?'待采集':a.work_count}<small>${esc(a.last_collected||'尚无成功采集')}</small><small class="collection-state" title="${esc(a.collection_error)}">${esc(a.collection_state||(a.homepage||a.douyin_id?'等待首次采集':'需填写真实抖音号'))}</small>${a.collection_error?`<small class="collection-error">${esc(a.collection_error)}</small>`:''}<button class="text-button" data-collect="${esc(a.id)}">采集</button></td><td class="note">${esc(a.note||'—')}</td><td><button class="text-button" data-edit="${esc(a.id)}">编辑</button><a class="text-button" href="/workspace.html?account=${encodeURIComponent(a.id)}">总览 / 历史</a></td></tr>`).join('')||'<tr><td colspan="10" class="empty-result">没有符合条件的账号。</td></tr>';
 $('selectedCount').textContent=`已选择 ${selected.size} 个账号`;$('selectAll').checked=accounts.length>0&&accounts.every(a=>selected.has(a.id));$('selectAll').indeterminate=selected.size>0&&!$('selectAll').checked;
 document.querySelector('#boardView .footnote').textContent=layoutActive?'发布位置来自工作进度表。点击待匹配格子选择对应账号，确认后即可记录发布；空位表示原表没有发布安排。':'点击未发或已发切换当天记录。';$('boardView').hidden=page!=='board';$('accountsView').hidden=page!=='accounts';$('title').textContent=page==='board'?'每日发布看板':'账号管理';$('breadcrumb').textContent=page==='board'?'每日发布':'账号资料';$('panelTitle').textContent=page==='board'?'主机发布矩阵':'账号清单';$('subtitle').textContent=page==='board'?'以工作进度表的电脑行、发布设备列为准。待匹配格子保留原文，确认账号后才能记录发布。':'状态人工维护，按电脑统一筛选。修改会同步到每日发布看板。';document.querySelectorAll('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));if(typeof renderBatchControls==='function')renderBatchControls();applyPermissions();
}
function edit(id){const a=data.accounts.find(a=>a.id===id)||{id:'',name:'',computer_id:'unassigned',slot:1,status:'待确认',douyin_id:'',homepage:'',note:''};lifecycleEdit(a);readinessEdit(a);phoneDeviceEdit(a);$('editId').value=a.id;$('editOfficeGroup').value=a.office_group||(a.id?'':activeOffice==='three'?'three':'');$('editTitle').textContent=a.id?`编辑账号 · ${a.name}`:'新增账号 / 小号';$('editName').value=a.name;$('editComputer').innerHTML=data.computers.map(c=>`<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');$('editComputer').value=a.computer_id;$('editSlot').value=a.slot||1;$('editStatus').innerHTML=data.statuses.map(s=>`<option>${esc(s)}</option>`).join('');$('editStatus').value=a.status;$('editDouyin').value=a.douyin_id;$('editHomepage').value=a.homepage;$('editNote').value=a.note;$('editError').textContent='';$('editor').showModal();captureVersions('editor');applyAccountPermissions(a);}
document.addEventListener('click',async e=>{const collect=e.target.closest('[data-collect]');if(collect)await queue([collect.dataset.collect]);const nav=e.target.closest('[data-page]');if(nav){page=nav.dataset.page;render();}const editor=e.target.closest('[data-edit]');if(editor)edit(editor.dataset.edit);const toggle=e.target.closest('[data-publish]');if(toggle){const a=data.accounts.find(a=>a.id===toggle.dataset.publish);const body={id:a.id,date:data.date,published:!a.published};toggle.disabled=true;try{await api('/api/daily',body);await load();toast(body.published?'已记录为已发':'已取消发布标记');}catch(e){toast(e.message);}finally{toggle.disabled=false;}}});
$('accountsBody').addEventListener('change',e=>{if(e.target.dataset.select){const id=e.target.dataset.select;e.target.checked?selected.add(id):selected.delete(id);render();}});
$('selectAll').onchange=()=>{filtered().forEach(a=>$('selectAll').checked?selected.add(a.id):selected.delete(a.id));render();};
$('applyBulk').onclick=async()=>{if(!selected.size)return toast('请先勾选账号');try{await api('/api/bulk-status',{ids:[...selected],status:$('bulkStatus').value});selected.clear();await load();toast('账号状态已批量更新');}catch(e){toast(e.message);}};
$('closeDialog').onclick=()=>$('editor').close();
$('editForm').onsubmit=async e=>{e.preventDefault();const button=e.submitter;button.disabled=true;try{if($('editId').value&&!hasPermission('account_manage')){const a=data.accounts.find(a=>a.id===$('editId').value);if(!a)throw Error('没有新增账号权限');if(hasPermission('account_status')&&a.status!==$('editStatus').value)await api('/api/account/status',{id:a.id,status:$('editStatus').value});if(hasPermission('account_progress')){await api('/api/account/card-readiness',{id:a.id,card_stability:$('editCardStability').value,password_state:$('editPasswordState').value});if(a.account_type==='大号'&&a.effective_auxiliary_state!==$('editAux').value)await api('/api/lifecycle-status',{id:a.id,auxiliary_state:$('editAux').value});}}else{await api($('editId').value?'/api/account':'/api/account/create',{...lifecyclePayload(),...readinessPayload(),phone_device_id:$('editPhoneDevice').value,office_group:$('editOfficeGroup').value,id:$('editId').value,name:$('editName').value,computer_id:$('editComputer').value,slot:Number($('editSlot').value),status:$('editStatus').value,note:$('editNote').value,douyin_id:$('editDouyin').value,homepage:$('editHomepage').value});}$('editor').close();await load();toast('已保存，两个页面已同步');}catch(e){$('editError').textContent=e.message;}finally{button.disabled=false;}};
accountSearchFields.forEach(id=>{$(id).oninput=()=>{activeLifecyclePreset='';render();};$(id).onkeydown=event=>{if(event.key==='Enter'){event.preventDefault();activeLifecyclePreset='';render();}};});['computer','status','published','loginPhoneFilter','verificationFilter'].forEach(id=>$(id).onchange=render);$('date').onchange=()=>{selected.clear();load();};$('today').onclick=()=>{$('date').value=data.today;load();};$('refresh').onclick=load;$('clear').onclick=()=>{clearAccountSearch();activeLifecyclePreset='';['query','computer','status','published','accountType','lifecycleFilter','ageFilter','loginPhoneFilter'].forEach(id=>$(id).value='');selected.clear();render();};window.addEventListener('focus',()=>{if(data&&!$('editor').open&&!$('cardEditor').open&&!$('phoneDeviceEditor').open&&!$('publishingMatchDialog').open&&!$('verificationEditor')?.open&&!$('batchEditor')?.open)load();});load();

async function queue(ids){if(!ids.length)return toast('没有可采集的账号');try{const result=await api('/api/collection/enqueue',{ids});await load();toast('已加入 '+result.queued+' 个任务'+(result.missing?'；'+result.missing+' 个缺少真实抖音号或主页':''));}catch(e){toast(e.message);}}
$('collectVisible').onclick=()=>queue(filtered().filter(a=>page!=='board'||a.computer_id!=='unassigned').map(a=>a.id));$('collectSelected').onclick=()=>queue([...selected]);$('autoCollect').onchange=async()=>{try{await api('/api/collection/settings',{auto_enabled:$('autoCollect').checked});await load();}catch(e){toast(e.message);}};$('resumeCollect').onclick=async()=>{try{await api('/api/collection/settings',{resume:true});await load();}catch(e){toast(e.message);}};$('openCollector').onclick=async()=>{try{await api('/api/collection/settings',{open_browser:true});toast('已通知服务器电脑打开抖音窗口；登录或验证完成后点击继续采集');await load();}catch(e){toast(e.message);}};setInterval(()=>{if(data&&!$('editor').open&&!$('cardEditor').open&&!$('phoneDeviceEditor').open&&!$('publishingMatchDialog').open&&!$('verificationEditor')?.open&&!$('batchEditor')?.open&&document.visibilityState==='visible')load();},5000);

$('pauseCollect').onclick=async()=>{try{await api('/api/collection/settings',{pause:true});await load();}catch(e){toast(e.message);}};
$('cancelCollect').onclick=async()=>{if(!confirm('取消所有办公室尚未开始的采集任务？已有作品数量保留，正在采集的任务会继续完成。'))return;try{await api('/api/collection/settings',{cancel_waiting:true});await load();toast('等待任务已取消；每日自动采集开启时仍会生成新任务');}catch(e){toast(e.message);}};
