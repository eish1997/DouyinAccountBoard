let devicePageIndex=1;
const devicePageSize=50;
function deviceAccounts(id){return data.accounts.filter(a=>a.phone_device_id===id);}
function emptyPhoneText(device){return device.state==='可用闲置'?'无当前登录账号，已人工确认可用闲置':'没有当前登录记录，未认定为空闲';}
function renderPhoneFilter(){const select=$('loginPhoneFilter'),value=select.value;select.innerHTML='<option value="">全部登录手机</option><option value="missing">未关联登录手机</option><option value="review">导入位置待核对</option>'+(data.phone_devices?.devices||[]).map(d=>`<option value="device:${esc(d.id)}">${esc(d.name)}</option>`).join('');select.value=value;}
function phoneDeviceMatches(a){const value=$('loginPhoneFilter').value;return !value||(value==='missing'&&!a.phone_device_id)||(value==='review'&&a.phone_device_source!=='manual'&&(a.phone_device_note||'').includes('待核对'))||(value.startsWith('device:')&&a.phone_device_id===value.slice(7));}
function phoneDeviceEdit(a){$('editPhoneDevice').innerHTML='<option value="">未关联 / 已移出手机</option>'+(data.phone_devices?.devices||[]).map(d=>`<option value="${esc(d.id)}">${esc(d.name)} · ${esc(d.state)}</option>`).join('');$('editPhoneDevice').value=a.phone_device_id||'';$('editPhoneDeviceNote').textContent=a.phone_device_note||'登录位置待补充，与注册手机卡分别记录';}
function filteredPhones(){const q=$('deviceQuery').value.trim().toLowerCase(),state=$('deviceStateFilter').value,occupancy=$('deviceOccupancyFilter').value;return (data.phone_devices?.devices||[]).filter(d=>{
 const own=deviceAccounts(d.id),accountFilter=['deviceLinkedIdQuery','deviceLinkedNameQuery','deviceLinkedDouyinQuery'].some(id=>searchValue(id));return (!state||d.state===state)&&deviceNumberMatches(d.id,q)&&containsText(d.name,searchValue('deviceNameQuery'))&&containsText(d.owner,searchValue('deviceOwnerQuery'))&&containsText(d.location,searchValue('deviceLocationQuery'))&&(!accountFilter||own.some(a=>exactText(a.id,searchValue('deviceLinkedIdQuery').replace(/^#/,''))&&containsText(a.name,searchValue('deviceLinkedNameQuery'))&&exactText(a.douyin_id,searchValue('deviceLinkedDouyinQuery'))))&&(!occupancy||(occupancy==='empty'&&!own.length)||(occupancy==='inactive'&&own.length>0&&d.inactive_count===own.length)||(occupancy==='active'&&own.length>d.inactive_count)||(occupancy==='multiple'&&own.length>1));
});}
function renderPhones(){
 const info=data.phone_devices||{devices:[],statuses:[],unassigned:0,unresolved:0},all=info.devices;
 const state=$('deviceStateFilter').value;$('deviceStateFilter').innerHTML='<option value="">全部设备状态</option>'+info.statuses.map(s=>`<option>${esc(s)}</option>`).join('');$('deviceStateFilter').value=state;
 $('title').textContent='手机设备管理';$('breadcrumb').textContent='手机设备';$('subtitle').textContent='按手机查看当前登录账号，区分待清理和确认可用的闲置设备。';document.querySelectorAll('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));
 $('stats').innerHTML=[['','手机设备',all.length,'来自登录手机列及卡位置编号'],['在用','在用',all.filter(d=>d.state==='在用').length,'当前有在用或待确认账号'],['待清理','待清理',all.filter(d=>d.state==='待清理').length,'仅封禁/停用，或人工标记'],['可用闲置','可用闲置',all.filter(d=>d.state==='可用闲置').length,'已移出账号并人工确认清理']].map(([value,label,count,hint])=>`<button type="button" class="stat device-stat" data-device-state="${value}"><div class="stat-label">${label}</div><strong>${count}</strong><small>${hint}</small></button>`).join('');
 $('reviewPhoneAccounts').textContent=`核对账号登录位置（${info.unresolved}）`;
 const devices=filteredPhones(),pages=Math.max(1,Math.ceil(devices.length/devicePageSize));devicePageIndex=Math.min(devicePageIndex,pages);
 $('phonesScope').textContent=`筛选 ${devices.length} / ${all.length} 台 · ${all.filter(d=>d.account_count===0&&d.state!=='可用闲置').length} 台无当前账号，需核对实物 · ${info.unassigned} 个账号未关联手机`;
 $('phonesBody').innerHTML=devices.slice((devicePageIndex-1)*devicePageSize,devicePageIndex*devicePageSize).map(d=>{
  const own=deviceAccounts(d.id),cards=(data.phone_cards?.cards||[]).filter(c=>c.location.split(' / ').some(v=>/^\d+$/.test(v)&&String(Number(v))===d.id));
  return `<tr><td>${typeof batchPick==='function'?batchPick('devices',d.id):''}</td><td><strong>${esc(d.name)}</strong><small>手机编号 ${esc(d.id.split(':').pop())} · ${d.id.startsWith('office3:')?'办公室三':'原有批次'}</small></td><td><span class="badge ${d.state==='在用'||d.state==='可用闲置'?'good':d.state==='待清理'||d.state==='故障'?'warn':''}">${esc(d.state)}</span><small>${d.state_source==='auto'?'按当前账号判断':'人工确认'}</small>${d.attention?`<small class="card-due">${esc(d.attention)}</small>`:''}</td><td>${own.slice(0,4).map(a=>`<small><strong>${esc(accountDisplay(a))}</strong> · ${esc(a.account_type)} · ${esc(a.status)}</small>`).join('')||('<small>'+emptyPhoneText(d)+'</small>')}${own.length?`<button class="text-button" data-device-accounts="${esc(d.id)}">查看 ${own.length} 个账号 ↗</button>`:''}</td><td>${cards.slice(0,3).map(c=>`<small>${esc(c.phone)} · ${esc(c.owner||'卡主待核对')} · ${esc(c.status)}</small>`).join('')||'<small>无卡位置记录</small>'}${cards.length>3?`<small>共 ${cards.length} 条位置记录</small>`:''}<small>此列不决定账号归属</small></td><td>${esc(d.owner||'负责人待填写')}<small>${esc(d.location||'实物位置待填写')}</small></td><td class="note">${esc(d.note||'—')}</td><td><button class="text-button" data-device-edit="${esc(d.id)}">编辑 / 调整账号</button></td></tr>`;
 }).join('')||'<tr><td colspan="8" class="empty-result">没有符合条件的手机设备。</td></tr>';
 $('phonesPage').textContent=`第 ${devicePageIndex} / ${pages} 页 · 每页 ${devicePageSize} 台`;$('phonesPrevious').disabled=devicePageIndex===1;$('phonesNext').disabled=devicePageIndex===pages;
 if(typeof renderBatchControls==='function')renderBatchControls();
}
function showPhoneAccounts(deviceId){clearAccountSearch();activeOffice=deviceId?accountOffice({phone_device_id:deviceId}):'pending';activeLifecyclePreset='';['query','computer','status','published','accountType','ageFilter','lifecycleFilter','loginPhoneFilter'].forEach(id=>$(id).value='');$('loginPhoneFilter').value=deviceId?'device:'+deviceId:'review';selected.clear();page='accounts';render();}
function editPhoneDevice(id){const d=data.phone_devices.devices.find(d=>d.id===id)||{};$('deviceIsNew').value=d.id?'':'yes';$('deviceKey').value=d.id||'';$('deviceId').value=d.id?d.id.split(':').pop():'';$('deviceId').readOnly=!!d.id;$('deviceGroup').value=d.id?.startsWith('office3:')?'office3:':'';$('deviceGroup').disabled=!!d.id;$('phoneDeviceEditTitle').textContent=d.id?'编辑 '+d.name:'新增手机设备';$('deviceState').innerHTML='<option value="auto">按账号自动判断</option>'+data.phone_devices.statuses.map(s=>`<option>${esc(s)}</option>`).join('');$('deviceState').value=d.state_source==='manual'?d.state:'auto';for(const [input,key] of [['deviceName','name'],['deviceOwner','owner'],['deviceLocation','location'],['deviceNote','note']])$(input).value=d[key]||'';$('deviceEditError').textContent='';$('phoneDeviceRelations').hidden=!d.id;['deviceAccountQuery','deviceAccountIdQuery','deviceAccountDouyinQuery'].forEach(id=>$(id).value='');renderDeviceRelations();$('phoneDeviceEditor').showModal();captureVersions('phoneDeviceEditor');applyDevicePermissions();}
function renderDeviceRelations(){const id=$('deviceKey').value;$('deviceAssignedAccounts').innerHTML=deviceAccounts(id).map(a=>`<div class="device-assigned-row"><strong>${esc(accountDisplay(a))}</strong><small>${esc(a.account_type)} · ${esc(a.status)}</small><button type="button" class="text-button" data-device-remove="${esc(a.id)}">移出本手机</button></div>`).join('')||'<p class="card-help">当前没有关联账号。确认设备已清理后，可标记可用闲置。</p>';renderDeviceAccountChoices();}
function renderDeviceAccountChoices(){const q=$('deviceAccountQuery').value.trim().toLowerCase(),id=$('deviceKey').value;const choices=data.accounts.filter(a=>a.phone_device_id!==id&&containsText(a.name,q)&&exactText(a.id,searchValue('deviceAccountIdQuery').replace(/^#/,''))&&exactText(a.douyin_id,searchValue('deviceAccountDouyinQuery'))).slice(0,100);$('deviceAccountChoice').innerHTML='<option value="">请选择账号（最多显示100条，请输入搜索）</option>'+choices.map(a=>`<option value="${esc(a.id)}">${esc(accountDisplay(a))} · ${esc(a.status)} · ${esc(a.phone_device_name||'未关联手机')}</option>`).join('');}
document.addEventListener('DOMContentLoaded',()=>{
 $('newPhoneDevice').onclick=()=>editPhoneDevice('');$('closePhoneDevice').onclick=()=>$('phoneDeviceEditor').close();$('refreshPhones').onclick=load;$('reviewPhoneAccounts').onclick=()=>showPhoneAccounts('');
 deviceSearchFields.forEach(id=>$(id).oninput=()=>{devicePageIndex=1;renderPhones();});['deviceStateFilter','deviceOccupancyFilter'].forEach(id=>$(id).onchange=()=>{devicePageIndex=1;renderPhones();});$('clearPhones').onclick=()=>{[...deviceSearchFields,'deviceStateFilter','deviceOccupancyFilter'].forEach(id=>$(id).value='');devicePageIndex=1;renderPhones();};$('phonesPrevious').onclick=()=>{devicePageIndex--;renderPhones();};$('phonesNext').onclick=()=>{devicePageIndex++;renderPhones();};
 document.addEventListener('click',e=>{const preset=e.target.closest('[data-device-state]');if(preset){$('deviceStateFilter').value=preset.dataset.deviceState;$('deviceOccupancyFilter').value='';devicePageIndex=1;renderPhones();}});
 $('phonesBody').onclick=e=>{const edit=e.target.closest('[data-device-edit]');if(edit)editPhoneDevice(edit.dataset.deviceEdit);const accounts=e.target.closest('[data-device-accounts]');if(accounts)showPhoneAccounts(accounts.dataset.deviceAccounts);};
 ['deviceAccountQuery','deviceAccountIdQuery','deviceAccountDouyinQuery'].forEach(id=>$(id).oninput=renderDeviceAccountChoices);
 $('assignPhoneAccount').onclick=async()=>{const button=$('assignPhoneAccount'),id=$('deviceAccountChoice').value;if(!id)return toast('请先选择账号');button.disabled=true;try{await api('/api/account/phone-device',{id,phone_device_id:$('deviceKey').value});await load();renderDeviceRelations();$('deviceState').value='auto';toast('登录手机已更新，卡和电脑资料保留');}catch(error){$('deviceEditError').textContent=error.message;}finally{button.disabled=false;}};
 $('deviceAssignedAccounts').onclick=async e=>{const button=e.target.closest('[data-device-remove]');if(!button)return;button.disabled=true;try{await api('/api/account/phone-device',{id:button.dataset.deviceRemove,phone_device_id:null});await load();renderDeviceRelations();toast('已移出当前手机，账号资料保留');}catch(error){$('deviceEditError').textContent=error.message;}finally{button.disabled=false;}};
 $('phoneDeviceForm').onsubmit=async e=>{e.preventDefault();const button=e.submitter;button.disabled=true;try{await api($('deviceIsNew').value?'/api/phone-device/create':'/api/phone-device',{id:$('deviceKey').value||$('deviceGroup').value+$('deviceId').value,name:$('deviceName').value,state:$('deviceState').value,owner:$('deviceOwner').value,location:$('deviceLocation').value,note:$('deviceNote').value});$('phoneDeviceEditor').close();await load();toast('手机设备资料已保存');}catch(error){$('deviceEditError').textContent=error.message;}finally{button.disabled=false;}};
});
