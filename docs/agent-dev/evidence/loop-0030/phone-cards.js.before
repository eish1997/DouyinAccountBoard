let cardPageIndex=1;
const cardPageSize=50;
function cardAccounts(phone){return data.accounts.filter(a=>a.registration_phone===phone);}
function readinessEdit(a){$('editCardStability').value=a.card_stability||'待确认';$('editPasswordState').value=a.password_state||'待确认';}
function readinessPayload(){return {card_stability:$('editCardStability').value,password_state:$('editPasswordState').value};}
function cardReady(card){const related=cardAccounts(card.phone),active=related.filter(a=>a.status!=='封禁');return active.length>0&&related.some(a=>a.account_type==='小号')&&related.filter(a=>a.account_type==='大号').length<=1&&active.every(a=>['大号','小号'].includes(a.account_type)&&a.card_stability==='已稳定'&&a.password_state==='已修改');}
function cardTaskMatches(c){const task=$('cardTask').value;return !task||(task==='cancel'&&c.status==='待注销')||(task==='code'&&c.code_state==='待接码')||(task==='return'&&c.return_state==='待归还')||(task==='blocked'&&cardAccounts(c.phone).some(a=>a.status==='封禁'))||(task==='ready'&&cardReady(c))||(task==='review'&&/卡主标注不一致|已销户|已注销|卡注销|收不了/.test(c.source_note||''));}
function cardExpiring(card){return !!card.expires_on&&card.expires_on<=new Date(Date.parse(data.today+'T00:00:00Z')+7*86400000).toISOString().slice(0,10);}
function filteredCards(){
 const q=$('cardQuery').value.trim().toLowerCase();
 return (data.phone_cards?.cards||[]).filter(c=>{
  const related=cardAccounts(c.phone);
  return cardTaskMatches(c)&&containsText(c.phone,q)&&locationNumberMatches(c.location,searchValue('cardLocationQuery'))&&containsText(c.owner,searchValue('cardOwnerQuery'))&&containsText(c.label,searchValue('cardLabelQuery'))&&(!searchValue('cardAccountNameQuery')||related.some(a=>containsText(a.name,searchValue('cardAccountNameQuery'))))&&(!$('cardStatus').value||c.status===$('cardStatus').value)&&(!$('cardCarrier').value||c.carrier===$('cardCarrier').value)&&(!$('cardLinked').value||(related.length>0)===($('cardLinked').value==='yes'))&&(!$('cardExpiry').value||($('cardExpiry').value==='soon'?cardExpiring(c):!c.expires_on));
 });
}
function renderCards(){
 const info=data.phone_cards||{cards:[],statuses:[],carriers:[],importable:0};
 for(const [id,options,label] of [['cardStatus',info.statuses,'全部手机卡状态'],['cardCarrier',info.carriers,'全部运营商']]){const value=$(id).value;$(id).innerHTML=`<option value="">${label}</option>`+options.map(s=>`<option>${esc(s)}</option>`).join('');$(id).value=value;}
 $('title').textContent='手机卡管理';$('breadcrumb').textContent='手机卡资料';$('subtitle').textContent='统一记录手机卡，查看号码关联的大小号和所属电脑。';document.querySelectorAll('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));
 const all=info.cards,linked=all.filter(c=>cardAccounts(c.phone).length>0).length;
 $('stats').innerHTML=[['手机卡总数',all.length,linked+' 张已关联账号'],['手机卡待注销',all.filter(c=>c.status==='待注销').length,'人工确认处理，不注销抖音账号'],['待接码',all.filter(c=>c.code_state==='待接码').length,'记录联系人与接码事项'],['待归还',all.filter(c=>c.return_state==='待归还').length,'记录卡主与归还日期']].map(([label,count,hint])=>`<div class="stat"><div class="stat-label">${label}</div><strong>${count}</strong><small>${hint}</small></div>`).join('');
 $('importCards').textContent=`从账号手机号补录（${info.importable}）`;$('importCards').disabled=info.importable===0;
 const cards=filteredCards(),pages=Math.max(1,Math.ceil(cards.length/cardPageSize));cardPageIndex=Math.min(cardPageIndex,pages);
 $('cardsScope').textContent=`筛选 ${cards.length} / ${all.length} 张卡 · 账号中另有 ${info.importable} 个号码可补录`;
 $('cardsBody').innerHTML=cards.slice((cardPageIndex-1)*cardPageSize,cardPageIndex*cardPageSize).map(c=>{
  const related=cardAccounts(c.phone),due=cardExpiring(c);
  const accounts=related.slice(0,3).map(a=>`<small>${esc(accountDisplay(a))} · ${esc(a.account_type)} · ${esc(a.status)} · 登录 ${esc(a.phone_device_name||'手机待确认')} · ${esc(data.computers.find(pc=>pc.id===a.computer_id)?.name||'未分配电脑')}</small><small>稳定：${esc(a.card_stability)} / 改密：${esc(a.password_state)}</small>`).join('');
  return `<tr><td>${typeof batchPick==='function'?batchPick('cards',c.id):''}</td><td><strong>${esc(c.phone)}</strong><small>${esc(c.label||'编号待补充')}</small></td><td class="card-location"><strong>${esc(c.location?c.location.split(' / ').map(v=>/^\d+$/.test(v)?v+'号手机':v).join(' / '):'位置待补充')}</strong></td><td>${esc(c.carrier)}</td><td><span class="badge ${c.status==='正常'?'good':['欠费','停机','待注销','已注销'].includes(c.status)?'warn':''}">${esc(c.status)}</span>${related.some(a=>a.status==='封禁')?'<small class="card-due">有关联账号封禁，请核对</small>':''}${cardReady(c)?'<small>稳定、改密条件已记录，可核对注销卡</small>':''}</td><td>${esc(c.owner||'卡主待核对')}<small>${esc(c.ownership||'待确认')} · 负责人 ${esc(c.keeper||'待补充')}</small></td><td><span class="${due?'card-due':''}">${esc(c.expires_on||'到期日未填')}</span><small>接码：${esc(c.code_state||'无待办')} · ${esc(c.code_contact||'联系人待补充')}</small><small>归还：${esc(c.return_state||'待确认')}${c.return_due?' / 预计 '+esc(c.return_due):''}${c.returned_on?' / 实际 '+esc(c.returned_on):''}</small></td><td>${related.length?accounts+`<button class="text-button" data-card-accounts="${esc(c.phone)}">查看全部 ${related.length} 个账号 ↗</button>`:'<small>暂无同手机号账号</small>'}</td><td class="note">${esc(c.note||'—')}${c.source_note?'<small>含腾讯原文，编辑中可核对</small>':''}</td><td><button class="text-button" data-card-edit="${c.id}">编辑 / 处理</button></td></tr>`;
 }).join('')||`<tr><td colspan="10" class="empty-result">${all.length?'没有符合条件的手机卡，试试重置筛选。':'还没有手机卡。可新增录入，或点击上方“从账号手机号补录”。'}</td></tr>`;
 $('cardsPage').textContent=`第 ${cardPageIndex} / ${pages} 页 · 每页 ${cardPageSize} 张`;$('cardsPrevious').disabled=cardPageIndex===1;$('cardsNext').disabled=cardPageIndex===pages;
 if(typeof renderBatchControls==='function')renderBatchControls();
}
function editCard(id){
 const card=data.phone_cards.cards.find(c=>c.id===id)||{};
 $('cardId').value=card.id||'';$('cardEditTitle').textContent=card.id?'编辑手机卡':'新增手机卡';
 for(const [input,key] of [['cardPhone','phone'],['cardLabel','label'],['cardOwner','owner'],['cardKeeper','keeper'],['cardCodeContact','code_contact'],['cardCodeNote','code_note'],['cardReturnDue','return_due'],['cardReturnedOn','returned_on'],['cardLocation','location'],['cardExpires','expires_on'],['cardNote','note']])$(input).value=card[key]||'';
 for(const [input,options,value] of [['cardEditCarrier',data.phone_cards.carriers,card.carrier],['cardEditStatus',data.phone_cards.statuses,card.status],['cardOwnership',data.phone_cards.ownerships,card.ownership],['cardCodeState',data.phone_cards.code_states,card.code_state],['cardReturnState',data.phone_cards.return_states,card.return_state]]){$(input).innerHTML=options.map(s=>`<option>${esc(s)}</option>`).join('');$(input).value=value||options[0];}
 $('cardSourceNote').textContent=card.source_note||'暂无腾讯文档导入原文';renderCardLinked(card.phone);
 $('cardEditError').textContent='';$('cardEditor').showModal();captureVersions('cardEditor');applyCardPermissions();
}
function renderCardLinked(phone){$('cardLinkedAccounts').innerHTML=cardAccounts(phone).map(a=>`<div class="card-account-row"><strong>${esc(accountDisplay(a))} · ${esc(a.account_type)}</strong><small>账号状态：${esc(a.status)}</small><label>稳定情况<select data-readiness-id="${esc(a.id)}" data-readiness-field="card_stability" aria-label="账号 ${esc(a.id)} 稳定情况">${['待确认','未稳定','已稳定'].map(s=>`<option ${a.card_stability===s?'selected':''}>${s}</option>`).join('')}</select></label><label>改密情况<select data-readiness-id="${esc(a.id)}" data-readiness-field="password_state" aria-label="账号 ${esc(a.id)} 改密情况">${['待确认','未修改','已修改'].map(s=>`<option ${a.password_state===s?'selected':''}>${s}</option>`).join('')}</select></label></div>`).join('')||'<p class="card-help">暂无同注册手机号的账号。请先保存号码，并核对账号管理中的注册手机号。</p>';}
document.addEventListener('DOMContentLoaded',()=>{
 $('newCard').onclick=()=>editCard(null);$('closeCardEditor').onclick=()=>$('cardEditor').close();$('refreshCards').onclick=load;
 cardSearchFields.forEach(id=>$(id).oninput=()=>{cardPageIndex=1;renderCards();});['cardStatus','cardCarrier','cardLinked','cardExpiry','cardTask'].forEach(id=>$(id).onchange=()=>{cardPageIndex=1;renderCards();});
 $('clearCards').onclick=()=>{[...cardSearchFields,'cardStatus','cardCarrier','cardLinked','cardExpiry','cardTask'].forEach(id=>$(id).value='');cardPageIndex=1;renderCards();};
 $('cardsPrevious').onclick=()=>{cardPageIndex--;renderCards();};$('cardsNext').onclick=()=>{cardPageIndex++;renderCards();};
 $('importCards').onclick=async()=>{const button=$('importCards');button.disabled=true;try{const result=await api('/api/phone-cards/import',{});await load();toast(`已补录 ${result.added} 张卡，卡状态待确认`);}catch(e){toast(e.message);}finally{button.disabled=!data.phone_cards.importable;}};
 $('cardsBody').onclick=e=>{const edit=e.target.closest('[data-card-edit]');if(edit)editCard(Number(edit.dataset.cardEdit));const related=e.target.closest('[data-card-accounts]');if(related){activeOffice='all';clearAccountSearch();activeLifecyclePreset='';['computer','status','published','accountType','ageFilter','lifecycleFilter','loginPhoneFilter'].forEach(id=>$(id).value='');$('accountPhoneQuery').value=related.dataset.cardAccounts;selected.clear();page='accounts';render();}};
 $('cardLinkedAccounts').onchange=async e=>{const select=e.target.closest('[data-readiness-id]');if(!select)return;select.disabled=true;try{await api('/api/account/card-readiness',{id:select.dataset.readinessId,[select.dataset.readinessField]:select.value});await load();renderCardLinked(data.phone_cards.cards.find(c=>c.id===Number($('cardId').value))?.phone||'');toast('账号稳定 / 改密记录已保存');}catch(error){toast(error.message);}finally{select.disabled=false;}};
 $('cardForm').onsubmit=async e=>{e.preventDefault();const button=e.submitter;button.disabled=true;try{const payload={id:$('cardId').value?Number($('cardId').value):null,phone:$('cardPhone').value,label:$('cardLabel').value,carrier:$('cardEditCarrier').value,status:$('cardEditStatus').value,owner:$('cardOwner').value,ownership:$('cardOwnership').value,keeper:$('cardKeeper').value,code_contact:$('cardCodeContact').value,code_state:$('cardCodeState').value,code_note:$('cardCodeNote').value,return_state:$('cardReturnState').value,return_due:$('cardReturnDue').value,returned_on:$('cardReturnedOn').value,location:$('cardLocation').value,expires_on:$('cardExpires').value,note:$('cardNote').value};if(payload.id&&!hasPermission('card_manage')){for(const key of Object.keys(payload))if(!['id','status','code_state','code_note','return_state','return_due','returned_on'].includes(key))delete payload[key];}await api('/api/phone-card',payload);$('cardEditor').close();await load();toast('手机卡已保存');}catch(error){$('cardEditError').textContent=error.message;}finally{button.disabled=false;}};
});
