// Pure UI model/markup checks; does not claim real browser acceptance.
const fs=require('node:fs'),vm=require('node:vm'),assert=require('node:assert/strict'),crypto=require('node:crypto');
const files=['static/offices.js','static/workspace-model.js','static/publishing-layout.js'];
const elements=new Map();
const element=id=>{if(!elements.has(id))elements.set(id,{hidden:false,innerHTML:'',textContent:'',value:''});return elements.get(id);};
const escape=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const context=vm.createContext({URLSearchParams,location:{search:'?office=three'},document:{addEventListener(){}},$:element,esc:escape,page:'accounts',data:null});
for(const file of files)vm.runInContext(fs.readFileSync(file,'utf8'),context,{filename:file});
const run=code=>vm.runInContext(code,context);
context.data={user:{scope_mode:'assigned'},offices:[{id:'office-A',name:'A<script>'}],computers:[{id:'pc-A',office_ids:['office-A']}],accounts:[{id:'account-A',office_ids:['office-A'],phone_device_id:'office3:1'},{id:'pending',office_ids:[],phone_device_id:'301'}]};
run('renderOffices()');
assert.equal(run('activeOffice'),'all');
assert.equal(run('accountOffice(data.accounts[0])'),'office-A');
assert.equal(run('accountOffice(data.accounts[1])'),'pending');
assert.equal(run('workspaceOffice(data.accounts[0])'),'office-A');
assert.equal(run('publishingCellOffice({computer_id:"pc-A"})'),'office-A');
assert.ok(element('officeTabs').innerHTML.includes('A&lt;script&gt;'));
assert.ok(!element('officeTabs').innerHTML.includes('办公室三'));
assert.ok(!element('officeTabs').innerHTML.includes('data-office="pending"'));
run('activeOffice="office-A"');
assert.equal(run('officeAccounts().length'),1);
context.data.offices=[];context.data.accounts=[];
run('renderOffices()');assert.equal(run('activeOffice'),'all');assert.equal(run('officeAccounts().length'),0);
context.data.user.scope_mode='all';run('renderOffices()');assert.ok(element('officeTabs').innerHTML.includes('data-office="pending"'));
assert.equal(run('workspaceOffice({phone_device_id:"301"})'),'two');
context.board={user:{scope_mode:'assigned'},accounts:[],computers:[],date:'2026-10-21',today:'2026-10-21',phone_cards:{cards:[{id:1,phone:'19900000001',office_ids:['office-A','office-B'],code_state:'待接码'}]},phone_devices:{devices:[{id:'301',name:'合成手机',office_ids:['office-A'],state:'待清理'}]}};
const tasks=run('workspaceTodos(board)');
assert.equal(tasks.length,2);assert.equal(tasks[0].offices.join(','),'office-A,office-B');assert.equal(tasks[1].office,'office-A');
console.log(JSON.stringify({passed:true,kind:'ui-model-and-markup-not-browser-acceptance',checks:9,source_sha256:Object.fromEntries(files.map(f=>[f,crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex')]))}));
